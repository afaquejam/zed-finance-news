<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.finance-brief.daily</string>
  <!-- Wrapped in `caffeinate -is` so that once the ~100s run starts it holds
       the Mac awake to completion. Without it, a scheduled pmset wake only
       lingers ~80s and the Mac re-sleeps mid-run. Pair with a pmset wake ~30s
       before 08:00 for ALL SEVEN days:
         sudo pmset repeat wakeorpoweron MTWRFSU 07:59:30
       so the Mac is awake when launchd fires.

       One agent runs a different pipeline per day (`date +%u`: Mon=1 … Sun=7):
         Sun (7) -> weekly wrap of the week just ended (skips itself if that
                    week's wrap was already generated by hand)
         Mon (1) -> week-ahead outlook for the coming Mon-Fri
         Tue-Sat -> the daily brief (each reports the previous session)
       Saturday runs the daily ONLY; the weekly moved to Sunday. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH="/usr/local/bin:$PATH"; export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] &amp;&amp; . "$NVM_DIR/nvm.sh"; export FINANCE_BRIEF_PUBLISH=1; cd /Users/afaqueh/development/new-projects/automated-content-generation/daily-finance-brief || exit 1; case "$(date +%u)" in 7) npm run brief:weekly ;; 1) npm run brief:outlook ;; *) npm run brief ;; esac</string>
  </array>
  <!-- Runs every day at 08:00 (Weekday: 0/7=Sun, 1=Mon … 6=Sat). The command
       above picks which pipeline runs for the day. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>0</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>6</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/afaqueh/development/new-projects/automated-content-generation/daily-finance-brief/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/afaqueh/development/new-projects/automated-content-generation/daily-finance-brief/logs/launchd.err.log</string>
</dict>
</plist>
